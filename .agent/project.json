{
  "schema_version": "harness.project.v1",
  "project": {
    "id": "plectarium",
    "name": "Plectarium",
    "repository_root": ".",
    "profile": "high-assurance",
    "blueprint_version": "1.0.0",
    "adoption_status": "adopted_local_foundation"
  },
  "paths": {
    "source": [
      "src/plectarium_contracts"
    ],
    "tests": [
      ".agent/tests",
      "plectarium-product-build-packet-v1/fixtures",
      "tests"
    ],
    "generated": [
      ".agent/generated"
    ],
    "instruction_roots": [
      "AGENTS.md"
    ],
    "fingerprint_exclusions": []
  },
  "commands": {
    "project_test": {
      "status": "active_internal_contracts",
      "run": "\"${PLECTARIUM_PACKET_PYTHON:-python3}\" -I -B -m unittest discover -s tests -p 'test_*.py'",
      "runtime_limitation": "Requires the explicitly selected interpreter with requirements-contracts.txt; installs nothing."
    },
    "project_lint": {
      "status": "not_configured",
      "run": null
    },
    "project_build": {
      "status": "deferred_no_distribution",
      "run": null
    },
    "project_closure": {
      "status": "active_setup_only",
      "run": "${PLECTARIUM_PACKET_PYTHON:-python3} -B plectarium-product-build-packet-v1/scripts/validate-packet.py --family-root ../../plectarium-family/repo"
    }
  },
  "extensions": {
    "registry": ".agent/extensions/registry.json",
    "registry_required_in_profile": "standard_or_higher"
  },
  "mutable_work_status": "prohibited_here"
}
