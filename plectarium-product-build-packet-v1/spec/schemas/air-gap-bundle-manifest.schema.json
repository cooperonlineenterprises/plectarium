{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plectarium.invalid/v1/air-gap-bundle-manifest.schema.json",
  "title": "Plectarium Air-Gap Bundle Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "direction", "tenant_id", "nonce", "created_at", "expires_at", "source_context_digest", "catalog_snapshot_digest", "suite_bom_digest", "family_source_lock_digest", "artifacts", "signature_status", "limitations"],
  "properties": {
    "schema_version": {"const": "plectarium.air-gap-bundle-manifest.v1"},
    "bundle_id": {"$ref": "common-definitions.schema.json#/$defs/identifier"},
    "direction": {"enum": ["execution_export", "result_import"]},
    "tenant_id": {"$ref": "common-definitions.schema.json#/$defs/tenant_id"},
    "nonce": {"type": "string", "minLength": 16},
    "created_at": {"$ref": "common-definitions.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "common-definitions.schema.json#/$defs/timestamp"},
    "source_context_digest": {"$ref": "common-definitions.schema.json#/$defs/sha256"},
    "catalog_snapshot_digest": {"$ref": "common-definitions.schema.json#/$defs/sha256"},
    "suite_bom_digest": {"$ref": "common-definitions.schema.json#/$defs/sha256"},
    "family_source_lock_digest": {"$ref": "common-definitions.schema.json#/$defs/sha256"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "content_digest", "bytes"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "content_digest": {"$ref": "common-definitions.schema.json#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}}}},
    "signature_status": {"enum": ["verified", "invalid", "untrusted_signer", "unsupported", "not_present", "not_checked"]},
    "limitations": {"$ref": "common-definitions.schema.json#/$defs/limitations"}
  }
}
